    "Sagt dir, ob die Mensa gerade offen hat und welche als Nächstes." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tells you whether the canteen is open right now and which one opens next."
          }
        }
      }
    },
    "Sagt dir, ob es heute Abendessen gibt, wo und was." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tells you whether there is dinner today, where and what."
          }
        }
      }
    },
    "Sagt dir, was es heute in der Mensa gibt, mit dem Filter aus der App." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tells you what is in the canteen today, using the filter from the app."
          }
        }
      }
    },
    "Sagt dir, was heute Abend los ist, und nennt Absagen." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tells you what’s on tonight and mentions cancellations."
          }
        }
      }
    },
    "Sagt dir, wie viele Titel deiner Merkliste im Regal stehen und wo. Ohne Anmeldung." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tells you how many titles on your reading list are on the shelf and where. No sign-in needed."
          }
        }
      }
    },
