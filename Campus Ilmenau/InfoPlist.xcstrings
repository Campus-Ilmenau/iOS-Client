  "strings" : {
    "NSCalendarsWriteOnlyAccessUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Damit du Veranstaltungen in deinen Kalender übernehmen kannst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So you can add events to your calendar."
          }
        }
      }
    },
    "NSCameraUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Kamera wird nur genutzt, um die Benutzernummer von deiner Thoska zu lesen. Es werden keine Bilder gespeichert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The camera is only used to read the user number from your Thoska. No images are saved."
          }
        }
      }
    },
    "NSFaceIDUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Damit nur du deinen Bibliotheksausweis zeigen kannst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So that only you can show your library card."
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Damit du geteilte Bilder in deinen Fotos sichern kannst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So you can save shared images to your Photos."
          }
        }
      }
    }
